@using Lageros.Models
@model Lageros.Models.ViewModels.OpremaFormViewModel

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="InventarniBroj" class="form-label"></label>
        <input asp-for="InventarniBroj" class="form-control" />
        <span asp-validation-for="InventarniBroj" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Vrsta" class="form-label"></label>
        <select asp-for="Vrsta" asp-items="Html.GetEnumSelectList<VrstaOpreme>()" class="form-select"></select>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Podvrsta" class="form-label"></label>
        <input asp-for="Podvrsta" class="form-control" placeholder="npr. Miš, Docking stanica" />
        <span asp-validation-for="Podvrsta" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Proizvodac" class="form-label"></label>
        <input asp-for="Proizvodac" class="form-control" />
        <span asp-validation-for="Proizvodac" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Model" class="form-label"></label>
        <input asp-for="Model" class="form-control" />
        <span asp-validation-for="Model" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="SerijskiBroj" class="form-label"></label>
        <input asp-for="SerijskiBroj" class="form-control" />
        <span asp-validation-for="SerijskiBroj" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="DatumNabave" class="form-label"></label>
        <input asp-for="DatumNabave" class="form-control" />
        <span asp-validation-for="DatumNabave" class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="Status" class="form-label"></label>
    @if (Model.JeZaduzena)
    {
        <input class="form-control" value="Zaduženo (mijenja se razduženjem)" disabled />
        <input type="hidden" asp-for="Status" />
    }
    else
    {
        <select asp-for="Status" class="form-select"
                asp-items="Html.GetEnumSelectList<StatusOpreme>().Where(s => s.Value != ((int)StatusOpreme.Zaduzeno).ToString())">
        </select>
    }
    <span asp-validation-for="Status" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Napomena" class="form-label"></label>
    <textarea asp-for="Napomena" class="form-control" rows="2"></textarea>
    <span asp-validation-for="Napomena" class="text-danger"></span>
</div>