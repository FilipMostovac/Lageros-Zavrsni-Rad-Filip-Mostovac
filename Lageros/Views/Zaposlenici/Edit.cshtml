@model Lageros.Models.ViewModels.ZaposlenikFormViewModel

@{
    ViewData["Title"] = "Uredi zaposlenika";
}

<h1>Uredi zaposlenika</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <partial name="_ZaposlenikFields" model="Model" />

    <div class="form-check mb-3">
        <input asp-for="Aktivan" class="form-check-input" />
        <label asp-for="Aktivan" class="form-check-label">Aktivan</label>
        <span asp-validation-for="Aktivan" class="text-danger d-block"></span>
    </div>

    <button type="submit" class="btn btn-success">Spremi</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Odustani</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}