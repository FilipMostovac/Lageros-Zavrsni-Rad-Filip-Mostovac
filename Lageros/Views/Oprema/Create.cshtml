@model Lageros.Models.ViewModels.OpremaFormViewModel

@{
    ViewData["Title"] = "Nova oprema";
}

<h1>Nova oprema</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <partial name="_OpremaFields" model="Model" />

    <button type="submit" class="btn btn-success">Spremi</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Odustani</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}