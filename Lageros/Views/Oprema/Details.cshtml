@using Lageros.Models
@model Lageros.Models.ViewModels.OpremaDetailsViewModel

@{
    ViewData["Title"] = $"{Model.Proizvodac} {Model.Model}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">@Model.Proizvodac @Model.Model</h1>
        <small class="text-muted">
            <code>@Model.InventarniBroj</code> · @Model.Vrsta.Naziv()@(Model.Podvrsta != null ? " · " + Model.Podvrsta : "")
        </small>
    </div>
    <div>
        @if (Model.Status == StatusOpreme.NaSkladistu)
        {
            <a asp-controller="Zaduzenja" asp-action="Zaduzi" asp-route-opremaId="@Model.Id" class="btn btn-success">Zaduži</a>
        }
        else if (Model.Status == StatusOpreme.Zaduzeno)
        {
            <a asp-controller="Zaduzenja" asp-action="Razduzi" asp-route-opremaId="@Model.Id" class="btn btn-warning">Razduži</a>
        }
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Uredi</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Natrag</a>
    </div>
</div>

<dl class="row">
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status.Naziv()</dd>

    <dt class="col-sm-3">Serijski broj</dt>
    <dd class="col-sm-9">@(Model.SerijskiBroj ?? "–")</dd>

    <dt class="col-sm-3">Datum nabave</dt>
    <dd class="col-sm-9">@(Model.DatumNabave?.ToString("dd.MM.yyyy.") ?? "–")</dd>

    <dt class="col-sm-3">Napomena</dt>
    <dd class="col-sm-9">@(Model.Napomena ?? "–")</dd>
</dl>

<h4 class="mt-4">Povijest zaduženja</h4>

@if (!Model.Povijest.Any())
{
    <p class="text-muted">Ova oprema još nije bila zadužena.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr><th>Zaposlenik</th><th>Zaduženo</th><th>Razduženo</th><th>Administrator</th><th>Napomena</th></tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Povijest)
            {
                <tr>
                    <td><a asp-controller="Zaposlenici" asp-action="Details" asp-route-id="@p.ZaposlenikId">@p.Zaposlenik</a></td>
                    <td>@p.DatumZaduzenja.ToString("dd.MM.yyyy.")</td>
                    <td>
                        @if (p.Aktivno)
                        {
                            <span class="badge bg-primary">aktivno</span>
                        }
                        else
                        {

                            @p.DatumRazduzenja!.Value.ToString("dd.MM.yyyy.")
                        }
                    </td>
                    <td><small>@p.Administrator</small></td>
                    <td>@p.Napomena</td>
                </tr>
            }
        </tbody>
    </table>
}